within MMChvdcLibrary.Information;
partial class Contact "Icon for contact information"

  annotation (Icon(coordinateSystem(preserveAspectRatio=false, extent={{-100,
            -100},{100,100}}), graphics={
        Rectangle(
          extent={{-100,70},{100,-72}},
          fillColor={235,235,235},
          fillPattern=FillPattern.Solid),
        Polygon(
          points={{-100,-72},{100,-72},{0,20},{-100,-72}},
          fillColor={215,215,215},
          fillPattern=FillPattern.Solid),
        Polygon(
          points={{22,0},{100,70},{100,-72},{22,0}},
          fillColor={235,235,235},
          fillPattern=FillPattern.Solid),
        Polygon(
          points={{-100,70},{100,70},{0,-20},{-100,70}},
          fillColor={241,241,241},
          fillPattern=FillPattern.Solid)}),
                            Documentation(info="<html>
<p>If you want to know details about the modeling of the MMC HVDC library, please contact us.</p>
<ol>
<li><b>MD Nazmul Hassan Chowdhury</b><br><i><a href=\"mailto:nishat6300@gmail.com\">nishat6300@gmail.com</a><br>Graduate student, Dept of ECSE<br>Rensselaer Polytechnic Institute</i></li>
<li><b>Luigi Vanfretti</b><br><i><a href=\"mailto:luigi.vanfretti@gmail.com\">luigi.vanfretti@gmail.com</a><br>Professor, Dept of ECSE<br>Rensselaer Polytechnic Institute</i></li>
</ol>
</html>"));
end Contact;
