within MMChvdcLibrary;
package Information "Contains information related to the MMC HVDC models"
  extends Modelica.Icons.Information;

  annotation (Documentation(info="<html>
<p>MMChvdcLibrary is a Modelica library for phasor-domain arm average value modeling of MMC-based HVDC systems, designed to be easily combined with OpenIPSL, for power system simulation. </p>
<p><br>This library provides modular converter models, control blocks, sensors, and mathematical operators, assembled into station-level models supporting P-Q, Vdc&ndash;Q, and Vac phasor control modes, along with a user-configurable master HVDC station integrating all three.</p>
<p><br>Examples are available under  <span style=\"font-family: Courier;\">MMChvdcLibrary.Examples.</span></p>
</html>"));
end Information;
