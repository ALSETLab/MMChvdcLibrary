         line_1.is.im:VARIABLE()  "Imaginary part of complex number" type: Real
         line_2.is.re:VARIABLE()  "Real part of complex number" type: Real
         line_1.is.re:VARIABLE()  "Real part of complex number" type: Real
         transformer.n.ii:VARIABLE(flow=true )  "Imaginary part of the current" type: Real
"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>// Do the parametric sweep using a loop
for i in 1:10 loop
  // We update the parameter using value
  value := i*10;
  // call the generated simulation code to produce a result files %i%_res.mat
  system("Tutorial.Example_1.Example_1 -override=G1.avr.K0="+String(value)+" -r=Example_1_parametric_" + String(i) + "_res.mat");
end for</Input>
      <Output>[done]</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot AutoScale="true" CurveWidth="1" Title="" CurveStyle="1" YLabel="" YRangeMin="0" Footer="" YRangeMax="0" XLabel="time" PlotType="0" LogX="false" LegendPosition="top" XRangeMin="0" Grid="detailed" LogY="false" XRangeMax="0">
        <Curve Visible="true" Title="B1.V" XData="" YData="" Color="4294901760"/>
      </OMCPlot>
      <Input>plot({B1.V},fileName="Example_1_parametric_9_res.mat")</Input>
      <Output>true</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot AutoScale="true" CurveWidth="1" Title="" CurveStyle="1" YLabel="" YRangeMin="0" Footer="" YRangeMax="0" XLabel="time" PlotType="0" LogX="false" LegendPosition="top" XRangeMin="0" Grid="detailed" LogY="false" XRangeMax="0">
        <Curve Visible="true" Title="B1.V" XData="" YData="" Color="4294901760"/>
      </OMCPlot>
      <Input>plot({B1.V},fileName="Example_1_parametric_5_res.mat")</Input>
      <Output>true</Output>
    </GraphCell>
  </GroupCell>
</Notebook>
