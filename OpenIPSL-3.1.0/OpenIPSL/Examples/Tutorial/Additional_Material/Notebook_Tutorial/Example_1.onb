<!DOCTYPE OMNotebook>
<Notebook>
  <GroupCell closed="false">
    <TextCell style="Title">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:7.875pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:10px; margin-bottom:10px; margin-left:10px; margin-right:10px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:20pt; font-weight:600; color:#000000;">OpenIPSL Tutorial Example 1&lt;br />Interactive Analysis using OMNotebook&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Author">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:7.875pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:14pt; font-style:italic; color:#000000;">Prof. Luigi Vanfretti, 2017-04-19&lt;/span>&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:12pt; font-style:italic; color:#000000;">Updated 2017-08-02. Note: Use of ./package.mo for loading models instead of mking a special release&lt;/span>&lt;/p>
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:12pt; font-style:italic; color:#000000;">luigi.vanfretti@gmail.com , http://alsetlab.com &lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <TextCell style="Subtitle">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:7.875pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:20pt; font-style:italic; color:#000000;">Part 1: Model Simulation&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <GraphCell style="Graph" closed="false">
      <Input>//Root folder of the library
rootpath:= "C:/dev/OpenIPSL-master/OpenIPSL/"; // &lt;---- Don't forget that the path should be be within " "
rootpath:= dirname(rootpath)</Input>
      <Output>"C:/dev/OpenIPSL-master/OpenIPSL/"
"C:/dev/OpenIPSL-master"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>//Load the standard MSL
loadModel(Modelica);
//Load the OpenIPSL
loadFile(rootpath + "/OpenIPSL/package.mo");
// Load the tutorial
loadFile(rootpath +"/ApplicationExamples/_Tutorial/Tutorial/package.mo");
//Check everything is in the model
//list(Tutorial.Example_1.Example_1) // uncomment when using the first time</Input>
      <Output>[done]</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>// Instantiate the model of the network
instantiateModel(Tutorial.Example_1.Example_1);
// Simulate the model
simulate(Tutorial.Example_1.Example_1, stopTime=10);</Input>
      <Output>
OMC-ERROR:
"Warning: Assuming fixed start value for the following 4 variables:
         G1.machine.e2d:VARIABLE(start = G1.machine.e2d0 )  "d-axis sub-transient voltage" type: Real
         G1.machine.e2q:VARIABLE(start = G1.machine.e2q0 )  "q-axis sub-transient voltage" type: Real
         G1.machine.e1d:VARIABLE(start = G1.machine.e1d0 )  "d-axis transient voltage" type: Real
         G1.machine.e1q:VARIABLE(start = G1.machine.e1q0 )  "q-axis transient voltage" type: Real
Warning: Iteration variables with default zero start attribute in torn nonlinear equation system:
         line_2.is.im:VARIABLE()  "Imaginary part of complex number" type: Real
         line_1.is.im:VARIABLE()  "Imaginary part of complex number" type: Real
         line_2.is.re:VARIABLE()  "Real part of complex number" type: Real
         line_1.is.re:VARIABLE()  "Real part of complex number" type: Real
         transformer.n.ii:VARIABLE(flow=true )  "Imaginary part of the current" type: Real
"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot AutoScale="true" CurveWidth="1" Title="" CurveStyle="1" YLabel="" YRangeMin="0" Footer="" YRangeMax="0" XLabel="time" PlotType="0" LogX="false" LegendPosition="top" XRangeMin="0" Grid="detailed" LogY="false" XRangeMax="0">
        <Curve Visible="true" Title="B1.V" XData="" YData="" Color="4294901760"/>
        <Curve Visible="true" Title="B2.V" XData="" YData="" Color="4278190335"/>
        <Curve Visible="true" Title="B3.V" XData="" YData="" Color="4283804160"/>
      </OMCPlot>
      <Input>// What can you plot!
//plotall()
plot({B1.V,B2.V,B3.V})</Input>
      <Output>true</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <OMCPlot AutoScale="true" CurveWidth="1" Title="" CurveStyle="1" YLabel="" YRangeMin="0" Footer="" YRangeMax="0" XLabel="time" PlotType="0" LogX="false" LegendPosition="top" XRangeMin="0" Grid="detailed" LogY="false" XRangeMax="0">
        <Curve Visible="true" Title="G1.avr.vf" XData="" YData="" Color="4294901760"/>
      </OMCPlot>
      <Input>plot(G1.avr.vf)</Input>
      <Output>true</Output>
    </GraphCell>
    <TextCell style="Subtitle">
      <Text>&lt;!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0//EN" "http://www.w3.org/TR/REC-html40/strict.dtd">
&lt;html>&lt;head>&lt;meta name="qrichtext" content="1" />&lt;style type="text/css">
p, li { white-space: pre-wrap; }
&lt;/style>&lt;/head>&lt;body style=" font-family:'MS Shell Dlg 2'; font-size:7.875pt; font-weight:400; font-style:normal;">
&lt;table border="0" style="-qt-table-type: root; margin-top:5px; margin-bottom:5px; margin-left:5px; margin-right:5px;">
&lt;tr>
&lt;td style="border: none;">
&lt;p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;span style=" font-family:'Arial'; font-size:24pt; font-style:italic; color:#000000;">Part 2: Linearization&lt;/span>&lt;/p>&lt;/td>&lt;/tr>&lt;/table>&lt;/body>&lt;/html></Text>
    </TextCell>
    <GraphCell style="Graph" closed="false">
      <Input>// Instantiate the model of the network
instantiateModel(Tutorial.Example_1.Example_1);
// Linearize the model
linearize(Tutorial.Example_1.Example_1, stopTime=0);</Input>
      <Output>
OMC-ERROR:
"Warning: Assuming fixed start value for the following 4 variables:
         G1.machine.e2d:VARIABLE(start = G1.machine.e2d0 )  "d-axis sub-transient voltage" type: Real
         G1.machine.e2q:VARIABLE(start = G1.machine.e2q0 )  "q-axis sub-transient voltage" type: Real
         G1.machine.e1d:VARIABLE(start = G1.machine.e1d0 )  "d-axis transient voltage" type: Real
         G1.machine.e1q:VARIABLE(start = G1.machine.e1q0 )  "q-axis transient voltage" type: Real
Warning: Iteration variables with default zero start attribute in torn nonlinear equation system:
         line_2.is.im:VARIABLE()  "Imaginary part of complex number" type: Real
         line_1.is.im:VARIABLE()  "Imaginary part of complex number" type: Real
         line_2.is.re:VARIABLE()  "Real part of complex number" type: Real
         line_1.is.re:VARIABLE()  "Real part of complex number" type: Real
         transformer.n.ii:VARIABLE(flow=true )  "Imaginary part of the current" type: Real
"</Output>
    </GraphCell>
    <GraphCell style="Graph" closed="false">
      <Input>// Load the linearized model
loadFile("linear_Tutorial.Example_1.Example_1.mo");
instantiateModel(linear_Tutorial_Example__1_Example__1);
// Exctract the A matrix
Astr:=getParameterValue(linear_Tutorial_Example__1_Example__1,"A");
writeFile("evalA.mos", "A := " + Astr + ";");
runScript("evalA.mos");
//Extract the eigenvalues from the A matrix
(eval,evec):= Modelica.Math.Matrices.eigenValues(A);
eval</Input>
      <Output>true
